<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets/inbox.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Product>Thorium Inbox</Product>
    <Description>A Windows inbox for sending PDFs and EPUBs to Thorium Reader.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ThoriumInbox.Core/ThoriumInbox.Core.csproj" />
  </ItemGroup>
</Project>
